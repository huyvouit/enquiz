# Copy to .env.release (gitignored) and fill in the real values: the repo is
# public, so they never go into git. Used by scripts/release.sh (plan D21).
PROJECT_ID=<project-id>
REGION=asia-southeast1
SITE=<site-id>
# SERVICE=enquiz-api

# Windows + Git Bash: the Cloud SDK is often not on PATH there. Uncomment and adjust.
# PATH="$PATH:/c/Users/<you>/AppData/Local/Google/Cloud SDK/google-cloud-sdk/bin"

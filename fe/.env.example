# Base URL of the backend API.
# Dev default "/api/v1" goes through the Vite proxy (see vite.config.ts).
# Production on Firebase Hosting: keep "/api/v1"; fe/firebase.json rewrites /api/**
# to the Cloud Run service, so the frontend and the API share one origin.
VITE_API_BASE_URL=/api/v1

# Live quiz socket server (plan 5, D19). Dev: leave empty (Vite proxy).
# Production: the Cloud Run URL, e.g. https://enquiz-api-xxxxx-as.a.run.app
# (Firebase Hosting does not forward WebSocket, so /api cannot be used).
VITE_LIVE_URL=

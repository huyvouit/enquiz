# Copy to .env and adjust.
PORT=3000

# A MongoDB connection string, or `memory` to run a throwaway in-memory DB (dev only).
MONGODB_URI=mongodb://localhost:27017/enquiz

# At least 16 characters. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (plan D22); the app refreshes it from the session cookie.
JWT_EXPIRES_IN=15m
# Login sessions: without "remember me" at most 12h; with it 7 days since the last
# use, at most 14 days after the login.
REFRESH_TTL_SESSION=12h
REFRESH_TTL_REMEMBER=7d
REFRESH_MAX_REMEMBER=14d
# Secure attribute of the session cookie (browsers accept it on http://localhost).
COOKIE_SECURE=true

# Oldest frontend release the API still works with (plan D25): older open apps
# update themselves after the current exam or match. Raise only for a breaking API change.
MIN_CLIENT_VERSION=0.0.0

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
# Live quiz socket (plan 5, D19): origins allowed to open wss:// straight on
# Cloud Run. Production: the Firebase Hosting domain(s), comma separated.
LIVE_CORS_ORIGINS=http://localhost:5173

# true => on startup, insert demo users/questions/quizzes if the DB has no users.
SEED_DEMO_DATA=true

# Login/register attempts allowed per USERNAME per minute (password-guessing protection).
AUTH_RATE_LIMIT=10
# Login/register requests allowed per IP per minute. Kept high: a whole school
# usually shares one public IP and a class logs in at the same moment.
AUTH_IP_RATE_LIMIT=100

# Number of reverse proxies in front of the API, so the rate limits see the real
# client IP. 0 = direct (local dev). Production: check GET /api/v1/health -> clientIp.
TRUST_PROXY=0
# Same for the live quiz socket (plan 5), which reaches Cloud Run directly: one
# proxy fewer than HTTP behind Firebase Hosting. Empty = same as TRUST_PROXY.
LIVE_TRUST_PROXY=

# Question images and listening audio: `local` (files in UPLOAD_DIR, served by this
# API), `s3` (S3-compatible bucket with keys) or `gcs` (Cloud Storage, no keys: signed
# in as the account the app runs as; production on Cloud Run).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Only for STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, MinIO...). Credentials come from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_URL=
# Only for STORAGE_DRIVER=gcs. Files are public at https://storage.googleapis.com/<bucket>.
GCS_BUCKET=

# Listening questions (plan D16): the server turns `audioText` into an MP3 when a
# question is saved; students only get the audio URL, never the text.
#   none   = no audio is made (questions show "no audio yet"; admin can backfill later)
#   google = Google Cloud Text-to-Speech, needs an API key restricted to that API
#   fake   = tests only
TTS_DRIVER=none
GOOGLE_TTS_API_KEY=
# Voice language (Cambridge YLE: en-GB) and, optionally, an exact voice name.
TTS_LANGUAGE=en-GB
TTS_VOICE=

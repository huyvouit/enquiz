  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migrate:phase2": "node scripts/migrate-phase2.mjs",
    "seed:content": "nest build && node dist/cli/seed-content.js",
    "create:admin": "nest build && node dist/cli/create-admin.js",
    "migrate:phase3": "node scripts/migrate-phase3.mjs"
  },

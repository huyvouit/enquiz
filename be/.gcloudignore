# Files NOT uploaded by `gcloud builds submit` (it ignores .dockerignore).
# Without this file gcloud would upload .env (secrets) and node_modules.
.gcloudignore
.git
node_modules
dist
*.tsbuildinfo
coverage
.env
.env.*
!.env.example
# Leading slash: only the local upload folder, not src/modules/uploads/
# (gcloudignore matches a bare name at any depth, like .gitignore).
/uploads
/backups
